{
  "name": "backend",
  "version": "1.0.0",
  "description": "specora-backend",
  "type": "module",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "nodemon server.js"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "server.js",
      "app.js"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules",
      "prisma",
      "storage",
      "*.test.js"
    ]
  },
  "author": "rehman",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.17.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.0",
    "faiss-node": "^0.5.1",
    "fastembed": "^1.14.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "html-to-docx": "^1.8.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "openai": "^6.17.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.15",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.1",
    "vitest": "^4.0.15"
  }
}