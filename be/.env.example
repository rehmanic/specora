# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://specora:your_secure_password@specora-db:5432/specora_db"

# Auth
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Others
CORS_ORIGIN=http://localhost:3000

# AI
GEMINI_API_KEY=your_gemini_api_key

# LiveKit
LIVEKIT_API_URL=wss://your-livekit-url.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Legal Feasibility (Norma)
NORMA_INDEX_PATH=./data/norma/processed/faiss_index.bin
NORMA_META_PATH=./data/norma/processed/chunk_metadata.json
NORMA_CHUNKS_PATH=./data/norma/processed/chunks.json
NORMA_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NORMA_TOP_K=5
NORMA_SIM_THRESHOLD=0.25
