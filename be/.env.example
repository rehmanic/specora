# Server
PORT=5000
NODE_ENV=development

# Database
POSTGRES_USER=specora
POSTGRES_PASSWORD=specora_dev
POSTGRES_DB=specora_db
DATABASE_URL="postgresql://specora:specora_dev@specora-db:5432/specora_db"

# Auth
JWT_SECRET=docker_dev_jwt_secret
JWT_EXPIRES_IN=

# Others
CORS_ORIGIN=http://localhost:3000

# AI
GEMINI_API_KEY=

# LiveKit
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Legal Feasibility (Norma)
NORMA_INDEX_PATH=./data/norma/processed/faiss_index.bin
NORMA_META_PATH=./data/norma/processed/chunk_metadata.json
NORMA_CHUNKS_PATH=./data/norma/processed/chunks.json
NORMA_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NORMA_TOP_K=5
NORMA_SIM_THRESHOLD=0.25
